# ==============================================================================
# POS By Songer Creative - Environment Configuration Template
# Salin berkas ini menjadi .env sebelum menjalankan backend server:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLIKASI & SERVER UTAMA
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME="POS By Songer Creative"
APP_URL=http://localhost:3000

# Nama Toko Default (Dapat diubah dinamis via Dashboard Seller)
STORE_NAME="Songer Creative"
STORE_TAGLINE="Digital Printing & Percetakan Terpadu"
STORE_PHONE="0888-5844-380"
STORE_ADDRESS="Jl. Percetakan Terpadu No. 88"

# ------------------------------------------------------------------------------
# 2. DATABASE RELASIONAL (PostgreSQL / Supabase / Neon / Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_songer_db?schema=public"

# (Opsional jika menggunakan Supabase Cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI & KEAMANAN (JWT / Session)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-key-songer-creative-2026-change-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=session-secret-key-pos-songer-998877

# Akun SuperAdmin Awal
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=SongerCreative2026!
DEFAULT_ADMIN_ROLE=superadmin

# ------------------------------------------------------------------------------
# 4. KASIR POS, INVOICE & PRINTER THERMAL
# ------------------------------------------------------------------------------
DEFAULT_INVOICE_MODE=custom
DEFAULT_INVOICE_PREFIX=DnC
INVOICE_PADDING_DIGITS=5

# Konfigurasi Printer Struk Thermal (ESC/POS)
PRINTER_TYPE=thermal
PRINTER_WIDTH_MM=58
PRINTER_NAME="POS-58"
AUTO_CUT_RECEIPT=true
OPEN_CASH_DRAWER=true

# ------------------------------------------------------------------------------
# 5. INTEGRASI WHATSAPP & NOTIFIKASI PEMESANAN
# ------------------------------------------------------------------------------
WA_ADMIN_PHONE=628885844380
WA_GATEWAY_URL=
WA_API_KEY=

# ------------------------------------------------------------------------------
# 6. UPLOAD BERKAS & PENYIMPANAN MEDIA
# ------------------------------------------------------------------------------
UPLOAD_DIR="D:/pos-songer-creative/uploads"
MAX_FILE_SIZE_KB=500
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/svg+xml"
